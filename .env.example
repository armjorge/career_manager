MAIN_PATH=/Users/you/career-files

# Pooled connection string from Neon Console → Connection details → psql
# Use the password shown when you copy the string (reset if needed).
DB_POSTGRESQL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon Auth base URL (same value can live in frontend/.env as VITE_NEON_AUTH_URL)
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth

DB_MONGO=mongodb+srv://user:password@cluster/?appName=CLUSTER
