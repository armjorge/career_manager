# Local development
ENVIRONMENT=local
PROJECT=career-app
CORS_ALLOW_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Neon pooled PostgreSQL connection string
DB_POSTGRESQL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Documents bucket (from tofu output documents_bucket_name)
DOCUMENTS_S3_BUCKET=career-app-dev-documents

# Cognito — required for local JWT validation of Bearer tokens
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
