# Set to "mock" for in-memory data, or your API base URL including /api/v1
# Local:  http://localhost:8000/api/v1
# AWS:    https://xxxxxxxx.execute-api.region.amazonaws.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Neon Auth Base URL from Neon Console → Auth → Configuration
# Example: https://ep-xxx.neonauth.us-east-2.aws.neon.build/neondb/auth
VITE_NEON_AUTH_URL=
